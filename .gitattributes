# Normalize line endings to LF in the repo and in every checkout, including
# Windows (core.autocrlf): gofmt, shellcheck and bash all expect LF.
* text=auto eol=lf

*.go    text eol=lf
*.sh    text eol=lf
*.bats  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
